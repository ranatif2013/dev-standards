# Copy to /etc/rana-ops/alert.env on the server (chmod 600). NEVER commit real values.
# Telegram: create a bot with @BotFather, send it any message, then open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail (optional; needs the `mail` command on the server)
ALERT_EMAIL=
