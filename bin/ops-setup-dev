#!/usr/bin/env bash
# machine03 (DEVELOPMENT), once: one SSH key for the GitHub account -> agents can clone
# every project and push branches. main stays safe via branch protection (PR + green CI).
set -euo pipefail
KEY="$HOME/.ssh/github_dev"
mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
[ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N "" -C "$(hostname)-dev" -f "$KEY"
# (re)write our block: GitHub over port 443 (ssh.github.com) - works even where port 22 is blocked
touch "$HOME/.ssh/config"; sed -i '/^# ops-dev-key$/,/IdentitiesOnly yes/d' "$HOME/.ssh/config"
printf '\n# ops-dev-key\nHost github.com\n  HostName ssh.github.com\n  Port 443\n  User git\n  IdentityFile %s\n  IdentitiesOnly yes\n' "$KEY" >> "$HOME/.ssh/config"
chmod 600 "$HOME/.ssh/config" "$KEY"
OUT=$(ssh -o StrictHostKeyChecking=accept-new -o ConnectTimeout=15 -T git@github.com 2>&1 || true)
if echo "$OUT" | grep -q "successfully authenticated"; then
  echo "OK: $(hostname) can reach all your GitHub repos. Next: ops-clone <repo>"
else
  echo "GitHub said: $OUT" | tail -3
  echo; echo "If the key is not on GitHub yet, ADD THIS LINE on GitHub -> Settings (your profile) -> SSH and GPG keys -> New SSH key, then run ops-setup-dev again:"; echo; cat "$KEY.pub"; exit 2
fi
