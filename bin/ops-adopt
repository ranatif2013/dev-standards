#!/usr/bin/env bash
# machine03, inside a project: add the standard files that are missing (never overwrites),
# on a branch, and push it for a PR. Usage: cd ~/projects/<repo> && ops-adopt
set -euo pipefail
T="$HOME/ops/template"; [ -d "$T" ] || { echo "run install.sh first"; exit 1; }
git rev-parse --git-dir >/dev/null
git checkout -q -b ops/adopt-standard
ADDED=0
while IFS= read -r f; do rel="${f#$T/}"; [ -e "$rel" ] && continue; mkdir -p "$(dirname "$rel")"; cp "$f" "$rel"; echo "+ $rel"; ADDED=1; done < <(find "$T" -type f)
[ $ADDED = 1 ] || { echo "nothing missing"; git checkout -q -; git branch -q -D ops/adopt-standard; exit 0; }
git add -A; git commit -q -m "Adopt dev-standards (AGENTS.md, .planning, REGRESSIONS, CI)"
git push -q -u origin ops/adopt-standard
echo "Pushed branch ops/adopt-standard -> open a PR on GitHub, fill AGENTS.md/.planning placeholders, merge."
